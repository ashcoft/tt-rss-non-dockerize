{
  "name": "tt-rss",
  "description": "A free, flexible, open-source, web-based news feed (RSS/Atom/other) reader and aggregator.",
  "version": "1.0.0",
  "type": "module",
  "snyk": {
    "ignore": {
      "SNYK-JS-IMAGESIZE-17295814": {
        "*": {
          "reason": "image-size vulnerability in less's transitive dependency used by vuetify. No fixed version available.",
          "expires": "2026-12-31T00:00:00.000Z"
        }
      },
      "SNYK-JS-IMAGESIZE-17295816": {
        "*": {
          "reason": "image-size vulnerability in less's transitive dependency used by vuetify. No fixed version available.",
          "expires": "2026-12-31T00:00:00.000Z"
        }
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint:vue": "eslint src/vue",
    "test:vue": "node --test tests/vue/*.test.mjs",
    "ask": "node --env-file-if-exists=.env src/openrouter/ask.ts",
    "test:e2e": "playwright test",
    "lint:css": "stylelint 'lib/flat-ttrss/**/*.css' 'plugins/**/*.css' 'themes/**/*.less'",
    "lint:js": "eslint js src",
    "phpunit": "XDEBUG_MODE=coverage ./vendor/bin/phpunit",
    "phpunit:integration": "./tests_integration/run.sh",
    "release:vite-dev": "semantic-release --extends ./.releaserc.vite-dev.json"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@openrouter/sdk": "^1.5.107",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.16",
    "pinia": "^4.1.0",
    "vue": "^3.5.43",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "gulp": "^5.0.1",
    "gulp-less": "^5.0.0",
    "gulp-touch-fd": "^2.0.0",
    "less": "^4.9.1",
    "postcss-less": "^7.0.1",
    "sass": "^1.107.0",
    "semantic-release": "^25.0.9",
    "stylelint": "^17.16.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.0.4",
    "vue-eslint-parser": "^10.4.1"
  },
  "pnpm": {
